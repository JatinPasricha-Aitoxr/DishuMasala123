+// PLACEHOLDER RATE — needs real client confirmation, same status as content/home.ts's founderStory
+// draft copy. 10% was chosen as a defensible starting point (roughly matching WELCOME5's order of
+// magnitude) but Arun has not signed off on this specific number; flagged, not invented, per
+// CLAUDE.md §8.
+const FALLBACK_CROSS_PILLAR_DISCOUNT_PERCENT = 10;
+
+/** The automatic cross-pillar bundle discount's percentage (CLAUDE.md §7.2's 2026-09-10
+ * amendment: incentivize a Tea-only or Masala-only shopper to add the other pillar), read from
+ * `settings` — never a hardcoded literal at a pricing call site (same discipline as
+ * `getFreeShippingThresholdPaise`). A whole-number percent, mirroring `coupons.value`'s
+ * `kind: "percent"` shape. */
+export async function getCrossPillarBundleDiscountPercent(): Promise<number> {
+  const [row] = await db
+    .select({ value: settings.value })
+    .from(settings)
+    .where(eq(settings.key, "cross_pillar_bundle_discount_percent"))
+    .limit(1);
+
+  if (row == null || typeof row.value !== "number") {
+    return FALLBACK_CROSS_PILLAR_DISCOUNT_PERCENT;
+  }
+  return row.value;
+}
